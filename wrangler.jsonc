/**
 * Presearchstr — Cloudflare Worker config
 *
 * NOTE: the worker "name" stays '0xpresearchstr' — renaming a Worker creates
 * a NEW deployment target (new URL, fresh bindings). Internal infra name only.
 *
 * One deployment serves both the app (static assets from ./dist) and the
 * autosigner API (worker.ts, POST /api/index). Same origin = no CORS for
 * this site; ALLOWED_ORIGINS in worker.ts whitelists 0xSearchstr's origin
 * for cross-site calls.
 *
 * Setup (once):
 *   1. npm i -g wrangler && wrangler login
 *   2. wrangler kv namespace create RATE_LIMIT_KV
 *      → paste the returned id into kv_namespaces below
 *   3. Convert the indexer bot nsec to hex (one time, locally):
 *        node -e "console.log(require('nostr-tools/nip19').decode('nsec1…').data.toString('hex'))"
 *   4. wrangler secret put INDEXER_NSEC_HEX   (paste the 64-char hex)
 *   5. wrangler deploy
 *
 * If you deploy through Shakespeare's Cloudflare provider instead of the
 * wrangler CLI, steps 2–4 still apply on the same Cloudflare account.
 */
{
  "name": "0xpresearchstr",
  "main": "worker.ts",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
