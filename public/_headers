# Cache rules (Netlify-compatible; ignored harmlessly elsewhere).
#
# Hashed bundles are immutable — safe to cache forever.
/main-*.js
  Cache-Control: public, max-age=31536000, immutable
/main-*.css
  Cache-Control: public, max-age=31536000, immutable
/shakespeare_*.js
  Cache-Control: public, max-age=31536000, immutable

# HTML must always be revalidated — a stale index.html pointing at a
# deleted hashed bundle is the classic "white screen after deploy".
/index.html
  Cache-Control: no-cache, must-revalidate
/404.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate
